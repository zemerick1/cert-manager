# Certificate Manager Configuration
# Copy this file to .env and update values for your environment

# Hostname ClearPass uses to download a certificate on port 80.
# Docker Compose publishes this container on port 80. The name must resolve to this host.
EDGE_DOMAIN=your-domain.example.com

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Background scheduler settings
SCHEDULER_ENABLED=true
SCHEDULER_TIME=00:30

# Nginx container name (for automatic reload after cert renewal)
NGINX_CONTAINER_NAME=nginx
